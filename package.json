{
  "name": "okf-catalog",
  "version": "0.1.3",
  "description": "An MCP server that serves a company's Open Knowledge Format (OKF) bundle to AI agents, with citations, provenance and a publish loop: qmd done right for OKF.",
  "keywords": [
    "okf",
    "open-knowledge-format",
    "mcp",
    "mcp-server",
    "knowledge-catalog",
    "qmd",
    "claude-code"
  ],
  "homepage": "https://github.com/drathm/okf-catalog#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drathm/okf-catalog.git"
  },
  "bugs": {
    "url": "https://github.com/drathm/okf-catalog/issues"
  },
  "author": "Bitfusion PR LLC (https://bitfusion.tech)",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "okf-catalog": "dist/cli.js"
  },
  "files": [
    "dist",
    "plugin",
    "recipes/publish",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node node_modules/@typescript/native/bin/tsc -p tsconfig.build.json",
    "prepare": "node node_modules/@typescript/native/bin/tsc -p tsconfig.build.json",
    "typecheck": "node node_modules/@typescript/native/bin/tsc --noEmit",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "check": "npm run lint && npm run typecheck && npm run depcruise",
    "pretest": "npm run build",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "@tobilu/qmd": "2.8.3",
    "better-sqlite3": "13.0.3",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm-footnote": "2.1.0",
    "mdast-util-gfm-table": "2.0.0",
    "mdast-util-to-string": "4.0.0",
    "micromark-extension-gfm-footnote": "2.1.0",
    "micromark-extension-gfm-table": "2.1.2",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@modelcontextprotocol/client": "2.3.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/mdast": "4.0.4",
    "@types/node": "24.19.1",
    "@types/unist": "3.0.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "dependency-cruiser": "18.5.0",
    "typescript": "5.9.3",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
